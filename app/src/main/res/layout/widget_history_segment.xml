<!-- Une gamme tenue dans le morceau, en colonnes fixes : heure, degré, tonalité, pavés, nom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/seg_time"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFCAC4D0"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/seg_degree"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFE6E1E9"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/seg_tonic"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFE6E1E9"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/seg_tiles"
        android:layout_width="wrap_content"
        android:layout_height="13dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart" />

    <TextView
        android:id="@+id/seg_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFCAC4D0"
        android:textSize="11sp" />
</LinearLayout>
