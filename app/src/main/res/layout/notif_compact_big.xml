<!-- Notification d'Android 12, dépliée : le nom du mode, la tonalité et les huit pavés en
     rangée, la progression d'accords, le morceau, puis la bascule à trois positions du fader
     (voir MixerUiState.cutMode) avec les boutons ♪ et ✕. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/big_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <LinearLayout
        android:id="@+id/big_scale_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/big_tonic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/big_tiles"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
    </LinearLayout>

    <TextView
        android:id="@+id/big_progression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <TextView
        android:id="@+id/big_track"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_music"
            style="@style/NotifSwitch"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_both"
            style="@style/NotifSwitch"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_video"
            style="@style/NotifSwitch"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_harmony"
            style="@style/NotifSwitch"
            android:layout_width="40dp"
            android:contentDescription="@string/notif_action_harmony"
            android:text="♪" />

        <TextView
            android:id="@+id/btn_stop"
            style="@style/NotifSwitch"
            android:layout_width="40dp"
            android:layout_marginEnd="0dp"
            android:contentDescription="@string/notif_action_stop"
            android:text="✕" />
    </LinearLayout>
</LinearLayout>
