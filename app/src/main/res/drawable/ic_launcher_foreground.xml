                android:type="sweep"
                android:centerX="54"
                android:centerY="54">
                <item android:offset="0.00" android:color="#FFFF1744" />
                <item android:offset="0.09" android:color="#FFFF5A36" />
                <item android:offset="0.21" android:color="#FFFF2D87" />
                <item android:offset="0.36" android:color="#FFB14DFF" />
