        android:pathData="M54,21a33,33 0 1,1 0,66a33,33 0 1,1 0,-66Z M57,35a17.5,17.5 0 1,0 0,35a17.5,17.5 0 1,0 0,-35Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="sweep"
                android:centerX="54"
                android:centerY="54">
                <item android:offset="0.00" android:color="#FFFF1744" />
                <item android:offset="0.09" android:color="#FFFF5A36" />
                <item android:offset="0.21" android:color="#FFFF2D87" />
                <item android:offset="0.36" android:color="#FFB14DFF" />
